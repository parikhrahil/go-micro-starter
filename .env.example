# ==============================================================================
# Application Configuration
# ==============================================================================
APP_ENV=development
APP_NAME=bookmark-manager-backend
HTTP_PORT=8080
LOG_LEVEL=debug

# ==============================================================================
# Database Configuration (PostgreSQL)
# ==============================================================================
# Format: postgres://username:password@hostname:port/database_name?sslmode=disable
DB_DSN=postgres://postgres:postgres_secure_pass@localhost:5432/db_name?sslmode=disable
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=25
DB_CONN_MAX_LIFETIME=15m

# ==============================================================================
# Cache & Task Engine Configuration (Redis)
# ==============================================================================
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=redis_secure_pass
REDIS_DB=0
REDIS_POOL_SIZE=10

# ==============================================================================
# Authentication Secrets
# ==============================================================================
JWT_SECRET=replace_this_with_a_long_cryptographically_secure_random_string_in_production
JWT_EXPIRY_HOURS=72

# ==============================================================================
# Telemetry & Observability Layer
# ==============================================================================
OTEL_SERVICE_NAME=service-name
OTEL_EXPORTER_OTLP_ENDPOINT=localhost:4317
METRICS_PORT=9090
